---
import { skills } from '../data/skills';
import ScrollHeading from './ScrollHeading.astro';
import Icon from './Icon.astro';
---
<section id="toolkit" class="skills-section page-width section-space" aria-labelledby="skills-heading">
  <div class="skills-intro"><div><p class="section-note">My toolkit</p><ScrollHeading id="skills-heading" lines={['Tools & technologies.']} /></div></div>
  <div class="toolkit-map">
    <span class="toolkit-spine" aria-hidden="true"></span>
    <span class="toolkit-hub" aria-hidden="true"><Icon name="star" /></span>
    {skills.map((group) => <section class="toolkit-group" aria-label={group.title}>
      <span class="toolkit-node" aria-hidden="true"></span>
      <h3>{group.title}</h3>
      <ul class="toolkit-terms" role="list">{group.items.map((item) => <li><span class="toolkit-word">{item}</span></li>)}</ul>
    </section>)}
  </div>
</section>
