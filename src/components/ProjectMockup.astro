---
interface Props { slug: string; view: 'overview' | 'detail'; title: string; }
const { slug, view, title } = Astro.props;
const finance = slug === 'tookbaht';
const loyalty = slug === 'loyalty';
const mobile = (finance && view === 'detail') || (loyalty && view === 'overview');
const surface = finance ? '#dce3cf' : loyalty ? '#d1ddd4' : '#e1e2d9';
const ink = finance ? '#e8eccf' : '#284738';
const panel = finance ? '#20241e' : '#f9fbf5';
const muted = finance ? '#a6b09b' : '#718474';
const accent = finance ? '#d4ef6d' : '#355a43';
const transactions = [['Coffee & breakfast', 'Food & drinks', '−฿145.00'], ['Monthly salary', 'Income', '+฿35,000.00'], ['Train ticket', 'Transport', '−฿62.00'], ['Groceries', 'Shopping', '−฿890.00']];
---
<svg class="project-mockup" viewBox="0 0 1000 680" fill="none" role="img" aria-label={`${title}, interface mockup with sample data`}>
  <rect width="1000" height="680" fill={surface} />
  {mobile ? <>
    <g transform="translate(210 58)">
      <rect width="270" height="558" rx="42" fill={finance ? '#303629' : '#2b3e32'} />
      <rect x="7" y="7" width="256" height="544" rx="35" fill={panel} />
      <rect x="91" y="15" width="88" height="23" rx="12" fill="#17211b" />
      <text x="26" y="36" fill={ink} font-size="11" font-weight="600">9:41</text>
      <path d="M228 26h16v7h-16z" stroke={muted}/>
      <text x="24" y="83" fill={ink} font-size="22" font-weight="600">{finance ? 'Your goals' : 'Hello, Alex'}</text>
      <text x="24" y="106" fill={muted} font-size="12">{finance ? 'Make room for what matters.' : 'A little closer to your next treat.'}</text>
      <rect x="22" y="129" width="226" height="158" rx="17" fill={finance ? '#323a26' : '#31543f'} />
      <text x="39" y="154" fill={finance ? muted : '#bdcfb7'} font-size="12">{finance ? 'Emergency fund' : 'Your points'}</text>
      <text x="38" y="207" fill={finance ? accent : '#edf2d9'} font-size="43" letter-spacing="-2">{finance ? '฿18,500' : '1,250'}</text>
      <text x="39" y="232" fill={finance ? muted : '#bdcfb7'} font-size="11">{finance ? 'of ฿30,000 saved' : 'Thanks for being part of it.'}</text>
      <rect x="39" y="253" width="190" height="5" rx="2.5" fill="#64705a" />
      <rect x="39" y="253" width={finance ? 117 : 152} height="5" rx="2.5" fill={finance ? accent : '#d4e6b7'} />
      <text x="24" y="321" fill={ink} font-size="14" font-weight="600">{finance ? 'A little progress, every day' : 'Rewards for you'}</text>
      {[0, 1].map((index) => <g transform={`translate(23 ${338 + index * 73})`}>
        <rect width="224" height="62" rx="10" fill={finance ? '#2b3027' : '#e9eee4'} />
        <rect x="12" y="13" width="36" height="36" rx="9" fill={finance ? '#414c31' : '#d2dfc7'} />
        <path d={index === 0 ? 'M23 24h14v15H23zM37 26h5v7h-5M21 43h19' : 'M23 28h16v14H23zm-2-5h20v5H21m10-8v27'} stroke={finance ? accent : '#43633c'} stroke-width="1.5" />
        <text x="59" y="27" fill={ink} font-size="12">{finance ? index === 0 ? 'Weekend away' : 'A new laptop' : index === 0 ? 'A coffee on us' : 'Something to celebrate'}</text>
        <text x="59" y="44" fill={muted} font-size="10">{finance ? index === 0 ? '฿4,200 of ฿10,000' : '฿8,000 of ฿40,000' : index === 0 ? '500 points' : '1,000 points'}</text>
      </g>)}
      <path d="M22 502h226" stroke={finance ? '#3e4938' : '#d4decf'} />
      <g fill={muted} font-size="10" text-anchor="middle"><text x="49" y="526">Home</text><text x="135" y="526">{finance ? 'Goals' : 'Rewards'}</text><text x="222" y="526">Profile</text></g>
      <rect x="100" y="539" width="70" height="4" rx="2" fill={muted} />
    </g>
    <g transform="translate(529 106)">
      <rect width="270" height="510" rx="42" fill="#2b3e32" />
      <rect x="7" y="7" width="256" height="496" rx="35" fill={panel} />
      <rect x="91" y="15" width="88" height="23" rx="12" fill="#17211b" />
      <text x="24" y="84" fill={ink} font-size="21" font-weight="600">{finance ? 'Emergency fund' : 'A coffee on us'}</text>
      <rect x="22" y="112" width="226" height="148" rx="16" fill={finance ? '#3c482c' : '#e0e8d5'} />
      {finance ? <><circle cx="134" cy="185" r="48" stroke="#738354" stroke-width="9" /><path d="M134 137a48 48 0 1 1-37 79" stroke={accent} stroke-width="9" stroke-linecap="round" /><text x="134" y="194" text-anchor="middle" fill={accent} font-size="25">62%</text></> : <><path d="M102 157h61v63h-61zm61 10h19v33h-19M91 231h85" stroke="#46683e" stroke-width="6" stroke-linejoin="round"/><path d="M116 149v-18m23 18v-18" stroke="#96ad7f" stroke-width="3" stroke-linecap="round" /></>}
      <text x="24" y="291" fill={ink} font-size="15">{finance ? 'Keep the momentum going.' : 'Make your next visit a good one.'}</text>
      <text x="24" y="316" fill={muted} font-size="12">{finance ? 'A little saved today goes a long way.' : 'Redeem with your points in LINE.'}</text>
      <path d="M24 337h221" stroke={finance ? '#46533a' : '#d4decf'}/>
      <text x="24" y="366" fill={muted} font-size="12">{finance ? 'Latest contribution' : 'Points needed'}</text>
      <text x="245" y="366" text-anchor="end" fill={ink} font-size="14">{finance ? '+฿1,500' : '500'}</text>
      <rect x="23" y="403" width="224" height="48" rx="10" fill={accent}/>
      <text x="135" y="433" text-anchor="middle" fill={finance ? '#25301b' : '#f1f5e6'} font-size="14" font-weight="600">{finance ? 'Add to this goal' : 'Redeem reward'}</text>
      <rect x="100" y="490" width="70" height="4" rx="2" fill={muted}/>
    </g>
  </> : <g transform="translate(65 72)">
    <rect x="0" y="0" width="870" height="536" rx="15" fill={panel} />
    <rect x="1" y="1" width="868" height="534" rx="14" stroke={finance ? '#48513b' : '#b7c5b6'} />
    <path d="M1 37h868" stroke={finance ? '#394230' : '#dce4d5'} />
    {[0, 1, 2].map((i) => <circle cx={19 + i * 13} cy="19" r="3" fill={finance ? '#6d795e' : '#a2b49c'} />)}
    <text x="435" y="23" text-anchor="middle" fill={muted} font-size="11">{finance ? 'Tookbaht' : loyalty ? 'Loyalty Platform' : 'Court Booking'}</text>
    <path d="M173 38v497" stroke={finance ? '#394230' : '#dce4d5'} />
    <text x="24" y="81" fill={ink} font-size="20" font-weight="600">{finance ? 'tookbaht' : loyalty ? 'Connections' : 'Court Booking'}</text>
    {(finance ? ['Overview', 'Transactions', 'Budgets', 'Goals'] : loyalty ? ['Overview', 'Campaigns', 'Rewards', 'Activity'] : ['Schedule', 'Bookings', 'Add-ons', 'Notifications']).map((label, i) => <>
      {i === (loyalty ? 1 : 0) && <rect x="13" y={111 + i * 44} width="147" height="35" rx="7" fill={finance ? '#3d492b' : '#e1e9d7'} />}
      <text x="26" y={133 + i * 44} fill={i === (loyalty ? 1 : 0) ? ink : muted} font-size="12">{label}</text>
    </>)}
    <text x="24" y="502" fill={muted} font-size="10">Interface mockup</text>
    {finance ? <>
      <text x="204" y="88" fill={ink} font-size="27" letter-spacing="-.8">Your money, at a glance.</text>
      <text x="204" y="112" fill={muted} font-size="11">October overview</text>
      {[['Left to spend', '฿21,930'], ['Income', '฿35,000'], ['Expenses', '฿13,070']].map(([label, amount], i) => <g transform={`translate(${204 + i * 210} 132)`}>
        <rect width="195" height="99" rx="10" fill={i === 0 ? '#39452b' : '#2b3225'} />
        <text x="16" y="27" fill={muted} font-size="11">{label}</text><text x="16" y="69" fill={i === 0 ? accent : ink} font-size="29" letter-spacing="-1">{amount}</text>
      </g>)}
      <text x="204" y="268" fill={ink} font-size="15" font-weight="600">Recent transactions</text>
      <text x="823" y="268" text-anchor="end" fill={muted} font-size="11">This month</text>
      {transactions.map(([name, type, amount], i) => <g transform={`translate(204 ${287 + i * 51})`}>
        <path d="M0 46h619" stroke="#3a4532" />
        <rect x="0" y="5" width="30" height="30" rx="8" fill="#3d492b"/><text x="15" y="26" text-anchor="middle" fill={accent} font-size="15">{i === 1 ? '+' : '−'}</text>
        <text x="44" y="18" fill={ink} font-size="12">{name}</text><text x="44" y="34" fill={muted} font-size="10">{type}</text>
        <text x="619" y="27" text-anchor="end" fill={i === 1 ? accent : ink} font-size="14">{amount}</text>
      </g>)}
    </> : loyalty ? <>
      <text x="204" y="88" fill={ink} font-size="27" letter-spacing="-.8">Make every visit count.</text>
      <text x="204" y="112" fill={muted} font-size="11">Campaigns and customer activity</text>
      <rect x="204" y="133" width="619" height="127" rx="11" fill="#35563f" />
      <text x="224" y="162" fill="#cedbc0" font-size="11">Active campaign</text><text x="224" y="194" fill="#f4f7e9" font-size="24">A little thank-you for coming back.</text>
      <text x="224" y="225" fill="#cedbc0" font-size="12">Earn points on every visit. Redeem something good.</text>
      <rect x="705" y="150" width="97" height="26" rx="13" fill="#d4e2bb"/><text x="753" y="167" fill="#35563f" text-anchor="middle" font-size="10">Live in LINE</text>
      <text x="204" y="299" fill={ink} font-size="15" font-weight="600">Recent activity</text>
      {[['Alex M.', 'Points earned', '+120'], ['Sam T.', 'Coffee redeemed', '−500'], ['Taylor R.', 'Points earned', '+80']].map(([name, activity, points], i) => <g transform={`translate(204 ${317 + i * 58})`}>
        <path d="M0 53h619" stroke="#dce4d5"/><circle cx="17" cy="24" r="17" fill="#e2ead9"/><text x="17" y="28" text-anchor="middle" fill="#486640" font-size="12">{name.charAt(0)}</text>
        <text x="47" y="20" fill={ink} font-size="13">{name}</text><text x="47" y="37" fill={muted} font-size="11">{activity}</text><text x="619" y="29" text-anchor="end" fill={ink} font-size="14">{points} pts</text>
      </g>)}
    </> : view === 'overview' ? <>
      <text x="204" y="88" fill={ink} font-size="27" letter-spacing="-.8">Make time to play.</text>
      <text x="204" y="112" fill={muted} font-size="11">Choose your court and an available time.</text>
      <rect x="204" y="135" width="619" height="61" rx="10" fill="#e6ecdf" />
      {['Mon 12', 'Tue 13', 'Wed 14', 'Thu 15', 'Fri 16', 'Sat 17', 'Sun 18'].map((day,i)=><><rect x={214+i*86} y="145" width="77" height="41" rx="7" fill={i===2?'#365332':'transparent'}/><text x={252+i*86} y="171" text-anchor="middle" fill={i===2?'#f7faeb':muted} font-size="11">{day}</text></>)}
      <g fill={ink} font-size="12"><text x="283" y="229">Court 1</text><text x="465" y="229">Court 2</text><text x="647" y="229">Court 3</text></g>
      {['09:00','10:00','11:00','12:00','13:00'].map((time,row)=><g><text x="204" y={265+row*48} fill={muted} font-size="11">{time}</text>{[0,1,2].map(col=><g><rect x={278+col*182} y={244+row*48} width="171" height="39" rx="6" fill={row===1&&col===1?'#365332':(row+col)%4===0?'#e8eae4':'#eef3e8'} stroke={row===1&&col===1?'#365332':'#d9e0d1'}/><text x={363+col*182} y={269+row*48} text-anchor="middle" font-size="11" fill={row===1&&col===1?'white':muted}>{row===1&&col===1?'Selected':(row+col)%4===0?'Reserved':'Available'}</text></g>)}</g>)}
      <text x="204" y="515" fill={muted} font-size="10">Flexible slots. Booking updates in LINE.</text>
    </> : <>
      <text x="204" y="88" fill={ink} font-size="27" letter-spacing="-.8">You're all set.</text><text x="204" y="112" fill={muted} font-size="11">Your booking, in one place.</text>
      <rect x="204" y="137" width="342" height="258" rx="12" fill="#e6eddd"/>
      <circle cx="241" cy="174" r="17" fill="#365332"/><path d="m234 174 5 5 10-11" stroke="white" stroke-width="2"/>
      <text x="269" y="179" fill={ink} font-size="16" font-weight="600">Booking confirmed</text>
      {[['Court','Court 2'],['Date','Wednesday, 14 October'],['Time','10:00 – 11:00'],['Add-on','Equipment rental']].map(([label,value],i)=><><text x="226" y={221+i*39} fill={muted} font-size="11">{label}</text><text x="524" y={221+i*39} text-anchor="end" fill={ink} font-size="12">{value}</text></>)}
      <rect x="567" y="137" width="256" height="258" rx="12" fill="#f1f4eb" stroke="#dce4d5"/>
      <text x="587" y="171" fill={ink} font-size="15" font-weight="600">Booking updates</text>
      <path d="M591 204v114" stroke="#bbcab0"/>
      {['Reservation received','Confirmation sent in LINE','See you on court'].map((label,i)=><><circle cx="591" cy={209+i*49} r="5" fill={i<2?'#4b6a3b':'#c5cfbc'}/><text x="608" y={214+i*49} fill={ink} font-size="11">{label}</text></>)}
      <rect x="204" y="422" width="619" height="56" rx="10" fill="#365332"/><text x="514" y="456" text-anchor="middle" fill="#f4f8e8" font-size="14">View your booking</text>
    </>}
  </g>}
</svg>
